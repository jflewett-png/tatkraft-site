---
import Layout from '../../layouts/Layout.astro';

const schema = {
	"@context": "https://schema.org",
	"@type": "Service",
	"name": "Agentic Content Engines",
	"provider": { "@type": "Organization", "name": "Tatkraft Marketing" },
	"areaServed": ["NZ", "AU"],
	"description": "AI-enabled content production workflows that keep content shipping at the pace AI search demands, built and handed over as a system you own."
};
---

<Layout
	title="AI Content Production — Agentic Content Engines"
	description="AI-enabled content production workflows that keep content shipping at the pace AI search demands, built and handed over as a system you own."
	schema={schema}
>
	<h1>Agentic Content Engines</h1>
	<p class="tagline">A production system, not a content backlog.</p>

	<p>
		AI search rewards sites that publish genuinely useful content consistently, not
		in occasional bursts. That pace is hard to sustain with a traditional content
		process. An agentic content engine uses AI agents inside a human-supervised
		workflow to keep production moving — built and handed over as something you own
		and run, not a black box you stay dependent on.
	</p>
	<p>
		This is the production engine behind AEO and GEO work — the sustained,
		high-quality output that content architecture and technical SEO depend on to
		actually earn AI citations, not a one-off project.
	</p>

	<h2>What this covers</h2>
	<ul>
		<li>AI-assisted content production workflows</li>
		<li>Content briefs and prompt systems built around your topical map</li>
		<li>Human-in-the-loop review and editorial checkpoints</li>
		<li>Publishing and distribution automation</li>
		<li>Scaling output without scaling headcount</li>
		<li>Handover and training so the system is yours to run</li>
	</ul>

	<a class="cta" href="/contact">Get in touch</a>
</Layout>
